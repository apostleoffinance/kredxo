# Monad — default to testnet for local development
# Official figures: 10,000 TPS, 300ms block frequency, 600ms finality
MONAD_NETWORK=testnet
MONAD_CHAIN_ID=10143
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
MONAD_WS_URL=wss://testnet-rpc.monad.xyz
MONAD_EXPLORER_URL=https://testnet.monadvision.com
MONAD_NATIVE_SYMBOL=MON

# Mainnet (do not use until Phase 15)
# MONAD_NETWORK=mainnet
# MONAD_CHAIN_ID=143
# MONAD_RPC_URL=https://rpc.monad.xyz
# MONAD_WS_URL=wss://rpc.monad.xyz
# MONAD_EXPLORER_URL=https://monadvision.com

# Backend
KREDXO_ENV=development
DATABASE_URL=postgresql+psycopg://kredxo:kredxo@127.0.0.1:15432/kredxo
API_HOST=0.0.0.0
API_PORT=8000
TRADING_ACCOUNT_ADDRESS=
CREDIT_VAULT_ADDRESS=
USDC_ADDRESS=
INDEXER_FROM_BLOCK=0
DEMO_WALLET=0x83000000000000000000000000000000000009A2

# Deployer (never commit the real key)
# PRIVATE_KEY=

# Frontend (Next.js inlines NEXT_PUBLIC_* at build time)
NEXT_PUBLIC_MONAD_CHAIN_ID=10143
NEXT_PUBLIC_MONAD_RPC_URL=https://testnet-rpc.monad.xyz
NEXT_PUBLIC_MONAD_WS_URL=wss://testnet-rpc.monad.xyz
NEXT_PUBLIC_MONAD_EXPLORER_URL=https://testnet.monadvision.com
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_VAULT_ADDRESS=
NEXT_PUBLIC_USDC_ADDRESS=
NEXT_PUBLIC_TRADING_ACCOUNT_ADDRESS=
NEXT_PUBLIC_RISK_CONTROLLER_ADDRESS=
